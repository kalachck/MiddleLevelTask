# Copy to ApiGateway/.env for local `npm run dev`.
# For Docker, set CLICKHOUSE_* / PORT / HOST in the repo root `.env` (see root `.env.example`).

CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin_pass
CLICKHOUSE_DB=SensorsReadings
PORT=8080
HOST=127.0.0.1
