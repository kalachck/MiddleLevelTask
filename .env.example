# Local development: UI + ApiGateway run on the host; backend runs via `docker compose up`.
# Copy sections into ApiGateway/.env and UI/.env (or copy this file to each folder).

# --- ApiGateway → ClickHouse in Docker (published port 8123) ---
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin_pass
CLICKHOUSE_DB=SensorsReadings
PORT=8080
HOST=127.0.0.1

# --- UI → local ApiGateway + DataProcessor SignalR in Docker (port 5136) ---
VITE_GRAPHQL_URL=http://localhost:8080/graphql
VITE_SIGNALR_HUB_URL=http://localhost:5136/hubs/sensors
