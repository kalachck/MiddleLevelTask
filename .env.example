# Copy to `.env` in the repo root for `docker compose` variable substitution.
# Env names match application code (ApiGateway process.env, UI VITE_* build args).

# --- ApiGateway (in-container: use ClickHouse service hostname) ---
CLICKHOUSE_HOST=http://clickhouse:8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin_pass
CLICKHOUSE_DB=SensorsReadings
PORT=8080
HOST=0.0.0.0

# --- UI (browser-facing URLs; published host ports) ---
VITE_GRAPHQL_URL=http://localhost:8080/graphql
VITE_SIGNALR_HUB_URL=http://localhost:5136/hubs/sensors
VITE_SIGNALR_HUB_KEY=c3VwZXItc2VjcmV0LWRhdGEtcHJvY2Vzc29yLWh1Yi1rZXk=

# Host port for the UI container (maps to nginx :80)
UI_PORT=3000
